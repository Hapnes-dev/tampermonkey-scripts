{
  "_note": "SANITIZED SYNTHETIC NEGATIVE-FIXTURE MANIFEST. Each case derives from verified-panel.json and parameters.json. No live plant, customer, controller, workbook, or personal data is retained. The 6-of-8 partial case is the miniature analogue of the incident's 120-of-184 exact source coverage.",
  "format": "iwmac-oversikt-linking-regressions",
  "version": 1,
  "cases": [
    {
      "id": "structurally-linked-missing-source",
      "requirement": "linked=true and a non-empty driver_id do not prove validity",
      "mutations": [
        {
          "object": "object_0",
          "field": "driver_id",
          "value": "NNNNN_AK3_AKC_0_11_1_0_999"
        }
      ],
      "expected_rules": ["O-B03", "O-B08"]
    },
    {
      "id": "resolved-driver-wrong-unit",
      "requirement": "an exact driver_id with a disagreeing unit_id is unresolved",
      "mutations": [
        {
          "object": "object_1",
          "field": "unit_id",
          "value": "001:011"
        }
      ],
      "expected_rules": ["O-B04", "O-B08"]
    },
    {
      "id": "same-suffix-wrong-driver-family",
      "requirement": "a familiar suffix under AK2 is not the AK3_AKC parameter",
      "mutations": [
        {
          "object": "object_2",
          "field": "driver_id",
          "value": "NNNNN_AK2_AKC_0_11_1_0_58"
        }
      ],
      "expected_rules": ["O-B03", "O-B08"]
    },
    {
      "id": "correct-plant-wrong-controller-index",
      "requirement": "a correct plant prefix with controller 13 does not prove controller 12",
      "mutations": [
        {
          "object": "object_4",
          "field": "driver_id",
          "value": "NNNNN_AK3_AKC_0_13_1_0_7"
        }
      ],
      "expected_rules": ["O-B03", "O-B08"]
    },
    {
      "id": "similar-alias-wrong-role",
      "requirement": "a similar alarm-looking alias cannot authorize a defrost parameter on an alarm object",
      "mutations": [
        {
          "object": "object_4",
          "field": "driver_id",
          "value": "NNNNN_AK3_AKC_0_12_1_0_60"
        },
        {
          "object": "object_4",
          "field": "alias_text",
          "value": "High-temp alarm"
        }
      ],
      "expected_rules": ["O-B05", "O-B06", "O-B08"]
    },
    {
      "id": "unresolved-claimed-linked-ready",
      "requirement": "an unresolved subset cannot be described as fully linked or linked-ready",
      "claim": "linked-ready",
      "mutations": [
        {
          "object": "object_6",
          "field": "driver_id",
          "value": "NNNNN_AK2_AKC_0_12_1_0_58"
        }
      ],
      "expected_rules": ["O-B03", "O-B08"]
    },
    {
      "id": "partial-six-of-eight",
      "requirement": "most objects resolving does not excuse the unresolved subset",
      "mutations": [
        {
          "object": "object_4",
          "field": "driver_id",
          "value": "NNNNN_AK3_AKC_0_13_1_0_7"
        },
        {
          "object": "object_6",
          "field": "driver_id",
          "value": "NNNNN_AK2_AKC_0_12_1_0_58"
        }
      ],
      "expected_source_resolved": 6,
      "expected_unresolved": 2,
      "expected_rules": ["O-B03", "O-B08"]
    },
    {
      "id": "replacement-object-10000-names",
      "requirement": "host-generated non-sequential object_10000-style names remain object identity and are not renumbered during comparison",
      "rename_start": 10000,
      "reverse_array": false,
      "expected_rules": ["O-S04"]
    },
    {
      "id": "reordered-export-controller-role-match",
      "requirement": "two exports are compared by controller and role, not array index",
      "rename_start": 10000,
      "reverse_array": true,
      "expected_rules": ["O-S04", "O-C12"]
    }
  ]
}
